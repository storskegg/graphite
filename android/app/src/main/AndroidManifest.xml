<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.usb.accessory" android:required="false" />

    <!-- Shared storage: read everything in scope on the source; list, hash and write on the target. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- The unattested role check looks for GrapheneOS's system apps (role/Roles.kt). -->
    <queries>
        <package android:name="app.grapheneos.setupwizard" />
        <package android:name="app.grapheneos.info" />
        <package android:name="app.grapheneos.apps" />
    </queries>

    <application
        android:name=".App"
        android:label="graphite"
        android:allowBackup="false"
        android:theme="@android:style/Theme.DeviceDefault.DayNight">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- The new phone (USB host) starts graphite here by switching this phone to AOA. -->
            <intent-filter>
                <action android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED" />
            </intent-filter>
            <meta-data
                android:name="android.hardware.usb.action.USB_ACCESSORY_ATTACHED"
                android:resource="@xml/accessory_filter" />
        </activity>
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
